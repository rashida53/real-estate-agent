# Root env example for real-estate-agent monorepo

# MCP server (Repliers wrapper)
# Used in packages/mcp-repliers (via REPLIERS_API_KEY)
REPLIERS_API_KEY=your_repliers_api_key_here

# LangChain backend
# OPENAI_API_KEY is read by @langchain/openai
OPENAI_API_KEY=your_openai_api_key_here

# Command used by the backend to start the MCP server via stdio.
# If unset, defaults to "node".
MCP_SERVER_COMMAND=node

# Optional JSON array of arguments passed to MCP_SERVER_COMMAND
# Example: ["packages/mcp-repliers/src/index.js"]
MCP_SERVER_ARGS=["packages/mcp-repliers/src/index.js"]

# Frontend (Vite)
# When running apps/web, this can override the dev proxy target.
# By default Vite proxy points to http://localhost:4000
VITE_API_URL=http://localhost:4000
